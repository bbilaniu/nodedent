{
  "name": "nodedent",
  "version": "2.4.4",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "ci:local": "npm run versioning:check && npm run lint && npm run typecheck && npm test && npm run docs:check && npm run build && npm run deployment:check && npm run security:check",
    "ci:local:full": "npm run ci:local && npm run deployment:matrix && npm run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "workflows:check": "actionlint",
    "test:e2e": "playwright test",
    "test:e2e:serve": "node scripts/serve-e2e.mjs",
    "test:smoke": "node --import tsx scripts/check-deployed-site.ts",
    "deployment:check": "node scripts/check-deployment-mode.mjs",
    "deployment:matrix": "node scripts/check-deployment-matrix.mjs",
    "docs:check": "node scripts/check-doc-lifecycle.mjs",
    "docs:workflow-graph": "tsx scripts/export-protocol-graph.ts",
    "test": "node --import tsx --test src/nodedent/__tests__/*.test.ts scripts/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-clinical-security.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset tag",
    "versioning:check": "node scripts/check-versioning.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}

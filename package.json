{
  "name": "nodedent",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "ci:local": "npm run versioning:check && npm run typecheck && npm test && npm run docs:check && npm run build && npm run deployment:check && npm run security:check",
    "deployment:check": "node scripts/check-deployment-mode.mjs",
    "deployment:matrix": "node scripts/check-deployment-matrix.mjs",
    "docs:check": "node scripts/check-doc-lifecycle.mjs",
    "docs:workflow-graph": "tsx scripts/export-protocol-graph.ts",
    "test": "node --import tsx --test src/nodedent/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-clinical-security.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset tag",
    "versioning:check": "node scripts/check-versioning.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
